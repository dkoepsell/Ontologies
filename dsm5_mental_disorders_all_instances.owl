  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Delusions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Delusions</rdfs:label>
    <rdfs:comment>Fixed beliefs that are not amenable to change in light of conflicting evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Major_Neurocognitive_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Neurocognitive_Disorders"/>
    <rdfs:label>Major Neurocognitive Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Antisocial_Personality_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Personality_Disorders"/>
    <rdfs:label>Antisocial Personality Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Adjustment_Disorders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Trauma-_and_Stressor-Related_Disorders"/>
    <rdfs:label>Adjustment Disorders</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Anxiety_Disorders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#DSM5_Mental_Disorder"/>
    <rdfs:label>Anxiety Disorders</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Clinically_significant_impairment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Clinically significant impairment</rdfs:label>
    <rdfs:comment>Symptoms cause clinically significant impairment in social, occupational, or other important areas of functioning.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Acute_Stress_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Trauma-_and_Stressor-Related_Disorders"/>
    <rdfs:label>Acute Stress Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Bipolar_and_Related_Disorders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#DSM5_Mental_Disorder"/>
    <rdfs:label>Bipolar and Related Disorders</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Agoraphobia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Anxiety_Disorders"/>
    <rdfs:label>Agoraphobia</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Mild_Neurocognitive_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Neurocognitive_Disorders"/>
    <rdfs:label>Mild Neurocognitive Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Increase_in_goal_directed_activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Increase in goal directed activity</rdfs:label>
    <rdfs:comment>Increase in goal-directed activity or psychomotor agitation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Disorganized_speech">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Disorganized speech</rdfs:label>
    <rdfs:comment>Frequent derailment or incoherence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Reactive_Attachment_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Trauma-_and_Stressor-Related_Disorders"/>
    <rdfs:label>Reactive Attachment Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Intrusion_symptoms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Intrusion symptoms</rdfs:label>
    <rdfs:comment>Recurrent, involuntary, and intrusive distressing memories.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Attention-Deficit/Hyperactivity_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#DSM5_Mental_Disorder"/>
    <rdfs:label>Attention-Deficit/Hyperactivity Disorder</rdfs:label>
    <rdfs:comment>Marked by an ongoing pattern of inattention and/or hyperactivity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Binge-Eating_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Feeding_and_Eating_Disorders"/>
    <rdfs:label>Binge-Eating Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Cannabis_Use_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Substance-Related_and_Addictive_Disorders"/>
    <rdfs:label>Cannabis Use Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Avoidance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Avoidance</rdfs:label>
    <rdfs:comment>Persistent avoidance of stimuli associated with the traumatic event.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Irritability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Irritability</rdfs:label>
    <rdfs:comment>Being irritable or moody.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Restricted_repetitive_patterns_instance">
    <rdf:type rdf:resource="http://example.org/md#Restricted_repetitive_patterns"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Delusions_instance">
    <rdf:type rdf:resource="http://example.org/md#Delusions"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Sleep_disturbance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Sleep disturbance</rdfs:label>
    <rdfs:comment>Difficulty falling or staying asleep.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Restlessness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Restlessness</rdfs:label>
    <rdfs:comment>Feeling keyed up or on edge.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Fatigue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Fatigue</rdfs:label>
    <rdfs:comment>Loss of energy nearly every day.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Presence_of_obsessions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Presence of obsessions</rdfs:label>
    <rdfs:comment>Recurrent and persistent thoughts, urges, or images.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Inflated_self_esteem">
