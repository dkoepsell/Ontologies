    <rdfs:comment>Perception-like experiences that occur without an external stimulus.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Attention-Deficit_Hyperactivity_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
