  <rdf:Description rdf:about="http://example.org/md#Disorganized_speech_instance">
    <rdf:type rdf:resource="http://example.org/md#Disorganized_speech"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Delusional_Disorder">
