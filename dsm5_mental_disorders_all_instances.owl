    <rdfs:label>Attention-Deficit/Hyperactivity Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Symptoms_present_early">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Symptoms present early</rdfs:label>
    <rdfs:comment>Symptoms must be present in the early developmental period.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Panic_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Anxiety_Disorders"/>
    <rdfs:label>Panic Disorder</rdfs:label>
  </rdf:Description>
