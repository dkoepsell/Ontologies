    <rdfs:comment>Disrupted sleep patterns.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Obsessive-Compulsive_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#DSM5_Mental_Disorder"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Obsessive-Compulsive_and_Related_Disorders"/>
    <rdfs:label>Obsessive-Compulsive Disorder</rdfs:label>
    <rdfs:comment>Recurrent and persistent thoughts and repetitive behaviors.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Symptoms_present_early_instance">
    <rdf:type rdf:resource="http://example.org/md#Symptoms_present_early"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Persistent_deficits_social_communication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Persistent deficits social communication</rdfs:label>
    <rdfs:comment>Persistent deficits in social communication and social interaction across multiple contexts.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Easily_fatigued">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Easily fatigued</rdfs:label>
    <rdfs:comment>Getting tired easily.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Post_Traumatic_Stress_Disorder">
    <md:hasDiagnosticCriterion rdf:resource="http://example.org/md#Exposure_to_trauma"/>
