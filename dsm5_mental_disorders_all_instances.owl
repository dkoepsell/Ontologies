  <rdf:Description rdf:about="http://example.org/md#Paranoid_Personality_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Personality_Disorders"/>
    <rdfs:label>Paranoid Personality Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Specific_Phobia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Anxiety_Disorders"/>
    <rdfs:label>Specific Phobia</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Decreased_need_for_sleep_instance">
    <rdf:type rdf:resource="http://example.org/md#Decreased_need_for_sleep"/>
