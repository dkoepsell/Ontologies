    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Negative alterations cognition mood</rdfs:label>
    <rdfs:comment>Inability to remember aspects of the trauma, exaggerated negative beliefs.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Excoriation_Skin-Picking_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Obsessive-Compulsive_and_Related_Disorders"/>
    <rdfs:label>Excoriation (Skin-Picking) Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Insomnia_or_hypersomnia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
