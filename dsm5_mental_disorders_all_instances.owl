    <md:hasDiagnosticCriterion rdf:resource="http://example.org/md#Arousal_reactivity"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Exposure_to_trauma"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Intrusion_symptoms"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Avoidance"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Negative_alterations_cognition_mood"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Arousal_reactivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Cyclothymic_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
