    <rdfs:label>Substance-Related and Addictive Disorders</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Anorexia_Nervosa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#DSM5_Mental_Disorder"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Feeding_and_Eating_Disorders"/>
    <rdfs:label>Anorexia Nervosa</rdfs:label>
    <rdfs:comment>Characterized by restriction of energy intake relative to requirements.</rdfs:comment>
  </rdf:Description>
