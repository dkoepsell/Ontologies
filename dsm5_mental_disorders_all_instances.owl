  <rdf:Description rdf:about="http://example.org/md#Schizoid_Personality_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Personality_Disorders"/>
    <rdfs:label>Schizoid Personality Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Borderline_Personality_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Personality_Disorders"/>
    <rdfs:label>Borderline Personality Disorder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Bipolar_I_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#DSM5_Mental_Disorder"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Bipolar_and_Related_Disorders"/>
    <rdfs:label>Bipolar I Disorder</rdfs:label>
    <rdfs:comment>Defined by manic episodes lasting at least 7 days.</rdfs:comment>
    <md:hasDiagnosticCriterion rdf:resource="http://example.org/md#Inflated_self_esteem"/>
    <md:hasDiagnosticCriterion rdf:resource="http://example.org/md#Decreased_need_for_sleep"/>
    <md:hasDiagnosticCriterion rdf:resource="http://example.org/md#More_talkative_than_usual"/>
    <md:hasDiagnosticCriterion rdf:resource="http://example.org/md#Flight_of_ideas"/>
    <md:hasDiagnosticCriterion rdf:resource="http://example.org/md#Increase_in_goal_directed_activity"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Inflated_self_esteem"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Decreased_need_for_sleep"/>
    <md:hasSymptom rdf:resource="http://example.org/md#More_talkative_than_usual"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Flight_of_ideas"/>
    <md:hasSymptom rdf:resource="http://example.org/md#Increase_in_goal_directed_activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/md#Schizoaffective_Disorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/md#Schizophrenia_Spectrum_and_Other_Psychotic_Disorders"/>
    <rdfs:label>Schizoaffective Disorder</rdfs:label>
